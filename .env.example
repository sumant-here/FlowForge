# FlowForge Environment Configuration Example
PROJECT_NAME="FlowForge"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (PostgreSQL for production, SQLite for zero-dep local dev)
DATABASE_URL="postgresql+asyncpg://flowforge:flowforge_secret@localhost:5432/flowforge"

# Redis
REDIS_URL="redis://localhost:6379/0"

# RabbitMQ
RABBITMQ_URL="amqp://flowforge:flowforge_secret@localhost:5672/"
USE_EMBEDDED_BROKER=false

# Security
SECRET_KEY="flowforge-super-secret-production-key-change-in-prod-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Worker Settings
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=15
WORKER_CONCURRENCY=4

# Demo Mode
ENABLE_DEMO_MODE=true
